            "required": false,
            "schema": {
              "enum": [
                "week",
                "all",
                "improved"
              ],
              "type": "string",
              "default": "week",
              "title": "Period"
            }
          },
          {
            "name": "squad",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Squad"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
