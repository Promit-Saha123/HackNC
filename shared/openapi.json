  "components": {
    "schemas": {
      "Briefing": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "audio_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Url"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "text"
        ],
        "title": "Briefing"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestToken": {
        "properties": {
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "token"
        ],
        "title": "IngestToken"
      },
      "Leaderboard": {
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "week",
              "all",
              "improved"
            ],
            "title": "Period"
          },
          "squad": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Squad"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/LeaderboardEntry"
            },
            "type": "array",
            "title": "Entries"
          }
        },
        "type": "object",
        "required": [
          "period",
          "entries"
        ],
        "title": "Leaderboard"
      },
      "LeaderboardEntry": {
        "properties": {
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "user_id": {
            "type": "integer",
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "squad": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Squad"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "streak_days": {
            "type": "integer",
            "title": "Streak Days"
          },
          "badge": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Badge"
          },
          "prev_rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Rank"
          },
          "delta": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delta"
          }
        },
        "type": "object",
        "required": [
          "rank",
          "user_id",
          "name",
          "score",
          "streak_days"
        ],
        "title": "LeaderboardEntry"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LoginResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "token": {
            "type": "string",
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "user",
          "token"
        ],
        "title": "LoginResponse"
      },
      "ManualNight": {
        "properties": {
          "bed": {
            "type": "string",
            "format": "date-time",
            "title": "Bed"
          },
          "wake": {
            "type": "string",
            "format": "date-time",
            "title": "Wake"
          }
        },
        "type": "object",
        "required": [
          "bed",
          "wake"
        ],
        "title": "ManualNight",
        "description": "A night typed in by hand. Send device-local wall-clock ISO times WITHOUT a UTC offset."
      },
      "NightScore": {
        "properties": {
          "day": {
            "type": "string",
            "format": "date",
            "title": "Day"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "bedtime": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bedtime"
          },
          "wake_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wake Time"
          }
        },
        "type": "object",
        "required": [
          "day",
          "score"
        ],
        "title": "NightScore"
      },
      "Overview": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "last_night": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SleepNight"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScoreBreakdown"
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/NightScore"
            },
            "type": "array",
            "title": "History",
            "default": []
          },
          "streak_days": {
            "type": "integer",
            "title": "Streak Days",
            "default": 0
          },
          "badge": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Badge"
          },
          "best_streak": {
            "type": "integer",
            "title": "Best Streak",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "user"
        ],
        "title": "Overview"
      },
      "Prefs": {
        "properties": {
