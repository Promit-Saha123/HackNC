    "/me/sleep": {
      "post": {
        "summary": "Log Night",
        "description": "Log a night by hand; one night per wake date, a new entry replaces the old.",
        "operationId": "log_night_me_sleep_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualNight"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SleepNight"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
