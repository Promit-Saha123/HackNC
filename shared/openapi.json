              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/User"
                  },
                  "type": "array",
                  "title": "Response Users Users Get"
                }
              }
            }
          }
        }
      }
    },
    "/users/{user_id}/overview": {
      "get": {
        "summary": "Overview",
        "operationId": "overview_users__user_id__overview_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "User Id"
            }
