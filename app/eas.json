{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:8000", "EXPO_PUBLIC_USE_MOCKS": "false" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_API_URL": "https://sleep-squad-api.onrender.com", "EXPO_PUBLIC_USE_MOCKS": "false" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://sleep-squad-api.onrender.com", "EXPO_PUBLIC_USE_MOCKS": "false" }
    }
  },
  "submit": { "production": {} }
}
