# Copy to app/.env (`copy .env.example .env`). EXPO_PUBLIC_* values are bundled into the app: never put secrets here.
# Defaults point at the live API, so the app works fully out of the box (log in as Maya / password sleepsquad, or sign up).
EXPO_PUBLIC_API_URL=https://sleep-squad-api.onrender.com
EXPO_PUBLIC_USE_MOCKS=false
# Offline / no-backend mode: EXPO_PUBLIC_USE_MOCKS=true. Local backend: EXPO_PUBLIC_API_URL=http://localhost:8000
